---
// GR Everyday recipe link: https://hth33-dev.vercel.app/gr-everyday/r/#<data>.
// With the app installed, iOS/macOS open the link in the app (Universal Link, see
// public/.well-known/apple-app-site-association) and this page never shows. Without it, this
// page reads the recipe from the #fragment in the browser (it is never sent to the server)
// and lists the settings to set on the camera by hand.
// <data> = JSON, deflated (raw), base64url. Made by the GR repo's Sources/Shared/RecipeLink.swift.
// `i`, when there, is the sample picture's id, served by the moment-img Worker at /s/{i}.jpg
// (GR repo: Sources/Shared/RecipeSamples.swift, supabase/functions/recipe-sample).
// The page reads in the reader's language, picked when it opens (src/scripts/gr-recipe-lang.ts).
import Base from '../../../layouts/Base.astro';
import gr from '../../../data/gr-everyday.json';
---
<Base lang="ko" title={`${gr.app} 레시피 · Recipe`} description="GR 카메라 이미지 컨트롤 레시피 · A RICOH GR image control recipe">
  <article class="project gr-recipe">
    <div class="gr-top">
      <p class="kicker" data-t="recipe">{gr.app} 레시피</p>
      <nav class="gr-langs" id="gr-langs" aria-label="언어"></nav>
    </div>
    <h1 id="name">레시피</h1>
    <p class="lead" id="control"></p>
    <div id="body" hidden>
      <img id="sample" class="sample" alt="" hidden />
      <table class="values"><tbody id="settings"></tbody></table>
      <section id="wb-box" hidden><h2 data-t="whiteBalance">화이트밸런스</h2><p id="wb"></p></section>
      <section id="memo-box" hidden><h2 data-t="memo">메모</h2><p id="memo"></p></section>
      <p class="gr-note" id="source"></p>
      <p class="actions">
        <a class="btn" id="open-app" href="#" data-t="openApp">GR Everyday에서 열기</a>
        <a class="btn ghost" href="/gr-everyday/" data-app-page data-t="aboutApp">앱 알아보기</a>
      </p>
      <p class="gr-note" data-t="howTo">카메라의 이미지 컨트롤 메뉴에서 맨 위 항목을 고르고, 위 값대로 맞추면 같은 레시피로 찍을 수 있어요. 앱이 있으면 Bluetooth로 Custom 칸에 바로 넣을 수 있어요.</p>
    </div>
    <p id="problem" class="gr-note" hidden data-t="unreadable">레시피를 읽지 못했어요. 링크가 중간에 잘렸을 수 있어요. 보낸 사람에게 다시 받아 주세요.</p>
    <p class="gr-note" data-t="disclaimer">{gr.app}는 RICOH IMAGING과 제휴하지 않은 독립 앱이며, RICOH 및 GR은 각 권리자의 상표예요.</p>
  </article>
</Base>

<script>
  import { chosenLang, paint, say, value, type RecipeLang } from '../../../scripts/gr-recipe-lang';

  const $ = (id: string) => document.getElementById(id)!;
  const IMAGE_BASE = 'https://moment-img.moment-img.workers.dev';
  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;

  function bytes(b64url: string): Uint8Array {
    const b64 = b64url.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (b64url.length % 4)) % 4);
    return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
  }

  async function read(fragment: string) {
    const stream = new Blob([bytes(fragment)]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
    const p = JSON.parse(await new Response(stream).text());
    if (p.v !== 1 || typeof p.n !== 'string') throw new Error('format');
    return p;
  }

  function row(name: string, value: string) {
    const tr = document.createElement('tr');
    const th = document.createElement('th');
    const td = document.createElement('td');
    th.textContent = name;
    td.textContent = value;
    tr.append(th, td);
    return tr;
  }

  let lang: RecipeLang = chosenLang();
  // The recipe read from the link, kept so a language switch only redraws.
  let recipe: any = null;

  function render() {
    paint(lang, (l) => { lang = l; render(); });
    const p = recipe;
    if (!p) { document.title = say(lang, 'recipe'); return; }
    // The recipe's name, memo and uploader are the sender's own words and stay as written.
    document.title = `${p.n} | ${say(lang, 'recipe')}`;
    $('name').textContent = p.n;
    $('control').textContent = typeof p.t === 'string' ? value(lang, p.t) : say(lang, 'controlCode', p.c);
    const settings = $('settings');
    settings.replaceChildren();
    for (const s of Array.isArray(p.s) ? p.s.slice(0, 40) : []) {
      if (Array.isArray(s) && s.length === 2) settings.append(row(value(lang, String(s[0])), value(lang, String(s[1]))));
    }
    if (typeof p.d === 'string') settings.append(row('HDF', value(lang, p.d)));
    if (typeof p.w === 'string') { $('wb').textContent = value(lang, p.w); $('wb-box').hidden = false; }
    if (typeof p.m === 'string') { $('memo').textContent = p.m; $('memo-box').hidden = false; }
    const source = [p.a && say(lang, 'author', p.a), p.k && say(lang, 'camera', p.k)].filter(Boolean).join(' · ');
    $('source').textContent = source;
    const sample = $('sample') as HTMLImageElement;
    sample.alt = say(lang, 'sample');
    if (typeof p.i === 'string' && UUID.test(p.i)) {
      const src = `${IMAGE_BASE}/s/${p.i}.jpg`;
      if (sample.getAttribute('src') !== src) {
        sample.onload = () => { sample.hidden = false; };
        sample.onerror = () => { sample.hidden = true; };
        sample.src = src;
      }
    } else {
      sample.hidden = true;
      sample.removeAttribute('src');
    }
  }

  async function show() {
    const fragment = location.hash.slice(1);
    recipe = null;
    $('body').hidden = true;
    $('problem').hidden = true;
    $('wb-box').hidden = true;
    $('memo-box').hidden = true;
    try {
      if (!fragment) throw new Error('empty');
      recipe = await read(fragment);
      (document.getElementById('open-app') as HTMLAnchorElement).href = `greveryday://recipe#${fragment}`;
      render();
      $('body').hidden = false;
    } catch {
      recipe = null;
      render();
      $('problem').hidden = false;
    }
  }
  paint(lang, (l) => { lang = l; render(); });
  show();
  window.addEventListener('hashchange', show);
</script>

<style>
  .gr-recipe:lang(ko) { word-break: keep-all; }
  .kicker { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .gr-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
  /* The switch's buttons are added by the script. */
  .gr-langs { display: flex; gap: 10px; font-size: 0.85rem; }
  .gr-langs :global(button) { background: none; border: 0; padding: 0; font: inherit; color: var(--muted); cursor: pointer; }
  .gr-langs :global(button[aria-current='true']) { color: var(--fg); font-weight: 600; }
  .sample { display: block; width: 100%; max-height: 70vh; object-fit: contain; border-radius: 12px; margin: 16px 0 4px; background: var(--line); }
  .values { width: 100%; border-collapse: collapse; margin: 16px 0; }
  /* Rows are added by the script, so they don't carry Astro's scoping attribute. */
  .values :global(th), .values :global(td) { padding: 8px 4px; border-bottom: 1px solid var(--line); text-align: left; }
  .values :global(th) { font-weight: 500; color: var(--muted); }
  .values :global(td) { text-align: right; font-variant-numeric: tabular-nums; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .btn.ghost { background: transparent; border: 1px solid var(--line); }
  .gr-note { color: var(--muted); font-size: 0.88rem; margin-top: 12px; }
</style>
