---
// GR Everyday recipe code link: https://hth33-dev.vercel.app/gr-everyday/c/#GR-7KQ3XM.
// With the app installed the link opens in the app (Universal Link). Without it, this page
// looks the code up (Supabase recipe_code_get, the same publishable key the app ships) and
// sends the browser on to the recipe page, /gr-everyday/r/#<data>, which lists the settings.
// Codes: GR repo supabase/migrations/20261121040000_recipe_codes.sql.
// The page reads in the reader's language, picked when it opens (src/scripts/gr-recipe-lang.ts).
import Base from '../../../layouts/Base.astro';
import gr from '../../../data/gr-everyday.json';
---
<Base lang="ko" title={`${gr.app} 레시피 코드 · Recipe Code`} description="GR 카메라 이미지 컨트롤 레시피 코드 · A RICOH GR image control recipe code">
  <article class="project gr-recipe">
    <div class="gr-top">
      <p class="kicker" data-t="code">{gr.app} 레시피 코드</p>
      <nav class="gr-langs" id="gr-langs" aria-label="언어"></nav>
    </div>
    <h1 id="code" data-t="codeTitle">레시피 코드</h1>
    <p class="lead" id="status" data-t="loading">레시피를 불러오는 중이에요…</p>
    <p class="actions">
      <a class="btn" id="open-app" href="#" data-t="openApp">GR Everyday에서 열기</a>
      <a class="btn ghost" href="/gr-everyday/" data-app-page data-t="aboutApp">앱 알아보기</a>
    </p>
    <p class="gr-note" data-t="codeHowTo">앱에서는 저장된 레시피 → … → 레시피 추가 → 코드·링크·QR로 가져오기에 코드를 입력해도 돼요.</p>
  </article>
</Base>

<script>
  import { chosenLang, paint as paintPage, say, type RecipeLang, type UIKey } from '../../../scripts/gr-recipe-lang';

  const SUPABASE = 'https://rqnwgvfirkfxfawnawzf.supabase.co';
  const KEY = 'sb_publishable_cojeybLAeRjdBFHpVxQtRA_Rz3BYm8_';
  const $ = (id: string) => document.getElementById(id)!;

  let lang: RecipeLang = chosenLang();

  function paint(l: RecipeLang, onSwitch: (l: RecipeLang) => void) {
    paintPage(l, onSwitch);
    document.title = say(l, 'code');
  }

  /// The status line's message; the language switch redraws it. A code once read replaces
  /// the title, which is then no longer translated.
  function set(status: UIKey, code?: string) {
    $('status').dataset.t = status;
    if (code) { delete $('code').dataset.t; $('code').textContent = code; }
    paint(lang, redraw);
  }

  function redraw(l: RecipeLang) { lang = l; paint(lang, redraw); }

  async function show() {
    $('code').dataset.t = 'codeTitle';
    paint(lang, redraw);
    const raw = decodeURIComponent(location.hash.slice(1)).toUpperCase().replace(/[^A-Z0-9]/g, '');
    const code = raw.length === 8 && raw.startsWith('GR') ? raw.slice(2) : raw;
    if (!/^[2-9A-HJKMNP-Z]{6}$/.test(code)) {
      set('badCode');
      return;
    }
    set('loading', `GR-${code}`);
    (document.getElementById('open-app') as HTMLAnchorElement).href = `greveryday://code#GR-${code}`;
    try {
      const res = await fetch(`${SUPABASE}/rest/v1/rpc/recipe_code_get`, {
        method: 'POST',
        headers: { apikey: KEY, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_code: code }),
      });
      const payload = res.ok ? await res.json() : null;
      if (typeof payload !== 'string' || !/^[A-Za-z0-9_-]+$/.test(payload)) {
        set('noCode');
        return;
      }
      // The recipe page picks the same language: a choice made here is saved, and with none
      // both pages go by the browser's languages.
      location.replace(`/gr-everyday/r/#${payload}`);
    } catch {
      set('offline');
    }
  }
  show();
  window.addEventListener('hashchange', show);
</script>

<style>
  .gr-recipe:lang(ko) { word-break: keep-all; }
  .kicker { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .gr-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
  /* The switch's buttons are added by the script. */
  .gr-langs { display: flex; gap: 10px; font-size: 0.85rem; }
  .gr-langs :global(button) { background: none; border: 0; padding: 0; font: inherit; color: var(--muted); cursor: pointer; }
  .gr-langs :global(button[aria-current='true']) { color: var(--fg); font-weight: 600; }
  #code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.04em; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .btn.ghost { background: transparent; border: 1px solid var(--line); }
  .gr-note { color: var(--muted); font-size: 0.88rem; margin-top: 12px; }
</style>
