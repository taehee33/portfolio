---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, localePath, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const projects = (await getCollection('projects', (p) => p.id.startsWith(`${lang}/`) && !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const alternates = { ko: localePath('ko'), en: localePath('en') };
---
<Base lang={lang} alternates={alternates}>
  <section class="hero">
    <h1>{s.heroTitle}</h1>
    <p>{s.heroBody}</p>
  </section>
  <h2>{s.projects}</h2>
  <ul class="cards">
    {projects.map((p) => (
      <li>
        <a class="card" href={p.data.href ?? localePath(lang, `/projects/${p.id.split('/').slice(1).join('/')}/`)}>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          <ul class="chips">{p.data.stack.slice(0, 4).map((x) => <li>{x}</li>)}</ul>
        </a>
      </li>
    ))}
  </ul>
</Base>
