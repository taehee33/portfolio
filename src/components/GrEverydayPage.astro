---
// GR Everyday support pages (App Store support and privacy policy URLs).
// /gr-everyday/ko/…, /gr-everyday/en/…, /gr-everyday/ja/… (src/pages/gr-everyday/[lang]/). The text comes from the app: src/data/gr-everyday.json is exported from the GR repo's
// Sources/Shared/AboutView.swift by scripts/legal-pages.py. Edit it there, not here.
import Base from '../layouts/Base.astro';
import gr from '../data/gr-everyday.json';

interface Props {
  page: 'support' | 'privacy' | 'terms';
  lang?: 'ko' | 'en' | 'ja';
}
const { page, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const doc = lang === 'ko' ? gr : gr[lang];
const operator = lang === 'ko' ? gr.operator : gr[lang].operator;
/// Every language's page at /gr-everyday/<lang>/…; /gr-everyday/ picks one by the browser.
const pageLangs = { ko: '한국어', en: 'English', ja: '日本語' } as const;
const path = (l: string, p: Props['page']) => `/gr-everyday/${l}/${p === 'support' ? '' : `${p}/`}`;
const here = { support: path(lang, 'support'), privacy: path(lang, 'privacy'), terms: path(lang, 'terms') };
const words = lang === 'ja'
  ? {
      support: 'サポート', privacy: 'プライバシーポリシー', terms: '利用規約',
      supportTitle: `${gr.app} サポート`, supportDescription: `${gr.app}の使い方とお問い合わせ`,
      effective: '施行日',
      lead: 'RICOH GRカメラの写真をiPhone・iPad・Macで受け取り、リモートで撮影し、モーメントで共有するアプリです。',
      contact: 'お問い合わせ',
      contactBody: '使用中に問題があったり、わからないことがあったりする場合は、メールでお知らせください。アプリの 設定 › アプリ情報とサポート › お問い合わせ からメールを送ると、アプリのバージョン・デバイス・カメラの情報が入力された状態になります。',
      contactNote: 'モーメントの不適切な写真・コメントはアプリからすぐに報告でき、メールでお知らせいただいた場合も24時間以内に確認します。アカウントの削除は、アプリの 設定 › アカウント › 退会 からすぐに行えます。',
      guide: '使い方',
      footer: `${gr.app}はRICOH IMAGINGと提携していない独立したアプリです。RICOHおよびGRは各権利者の商標です。お問い合わせ:`,
    }
  : en
  ? {
      support: 'Support', privacy: 'Privacy Policy', terms: 'Terms of Use',
      supportTitle: `${gr.app} Support`, supportDescription: `How to use ${gr.app}, and how to reach us`,
      effective: 'Effective',
      lead: 'Get photos from your RICOH GR camera on iPhone, iPad, and Mac, shoot remotely, and share them in Moments.',
      contact: 'Contact Us',
      contactBody: 'If something isn’t working or you have a question, send us an email. Sending it from the app’s Settings › About & Support › Contact fills in your app version, device, and camera info.',
      contactNote: 'Inappropriate photos and comments in Moments can be reported right in the app; reports by email are also reviewed within 24 hours. You can delete your account anytime in the app under Settings › Account › Delete Account.',
      guide: 'How to Use',
      footer: `${gr.app} is an independent app not affiliated with RICOH IMAGING. RICOH and GR are trademarks of their respective owners. Contact:`,
    }
  : {
      support: '지원', privacy: '개인정보 처리방침', terms: '이용약관',
      supportTitle: `${gr.app} 지원`, supportDescription: `${gr.app} 사용 방법과 문의`,
      effective: '시행일',
      lead: 'RICOH GR 카메라의 사진을 iPhone·iPad·Mac으로 받고, 원격으로 촬영하고, 순간들에서 공유하는 앱이에요.',
      contact: '문의하기',
      contactBody: '사용 중 문제가 있거나 궁금한 점이 있으면 메일을 보내 주세요. 앱의 설정 › 앱 정보 및 지원 › 문의에서 메일을 보내면 앱 버전·기기·카메라 정보가 미리 들어가요.',
      contactNote: '순간들의 부적절한 사진·댓글은 앱에서 바로 신고할 수 있고, 메일로 알려 주셔도 24시간 안에 확인해요. 계정 삭제는 앱의 설정 › 계정 › 탈퇴에서 바로 할 수 있어요.',
      guide: '사용 방법',
      footer: `${gr.app}는 RICOH IMAGING과 제휴하지 않은 독립 앱이며, RICOH 및 GR은 각 권리자의 상표예요. 문의:`,
    };
const nav = [
  ['support', words.support, here.support],
  ['privacy', words.privacy, here.privacy],
  ['terms', words.terms, here.terms],
] as const;
const title = page === 'support' ? words.supportTitle : page === 'privacy' ? words.privacy : words.terms;
const description =
  page === 'support' ? words.supportDescription : `${gr.app} ${title} (${words.effective} ${gr.effectiveDate})`;
const sections = page === 'privacy' ? doc.privacy : page === 'terms' ? doc.terms : [];
---
<Base
  lang={lang === 'ja' ? 'en' : lang}
  docLang={lang}
  title={page === 'support' ? title : `${gr.app} ${title}`}
  description={description}
  alternates={{ ko: path('ko', page), en: path('en', page), ja: path('ja', page) }}
>
  <div class="gr-bar">
    <nav class="gr-tabs" aria-label={gr.app}>
      {nav.map(([key, label, href]) => (
        <a href={href} aria-current={key === page ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <nav class="gr-langs" aria-label={lang === 'ko' ? '언어' : lang === 'ja' ? '言語' : 'Language'}>
      {Object.entries(pageLangs).map(([l, label]) => (
        <a href={path(l, page)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
  <article class="project gr-doc">
    <h1>{title}</h1>
    {page === 'support' ? (
      <>
        <p class="lead">{words.lead}</p>
        <section class="support">
          <h2>{words.contact}</h2>
          <p>{words.contactBody}</p>
          <p><a class="btn" href={`mailto:${gr.email}`}>{gr.email}</a></p>
          <p class="gr-note">{words.contactNote}</p>
        </section>
        <h2>{words.guide}</h2>
        <ul class="cards">
          {doc.guide.map((s) => (
            <li class="card"><h3>{s.title}</h3><p>{s.body}</p></li>
          ))}
        </ul>
      </>
    ) : (
      <>
        <p class="lead">{words.effective} {gr.effectiveDate} · {operator}</p>
        <div class="prose">
          {sections.map((s) => (
            <section><h2>{s.title}</h2><p>{s.body}</p></section>
          ))}
        </div>
      </>
    )}
    <p class="gr-note">{words.footer} <a href={`mailto:${gr.email}`}>{gr.email}</a></p>
  </article>
</Base>

<style>
  .gr-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin: 8px 0 20px; }
  .gr-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
  .gr-langs { display: flex; gap: 10px; font-size: 0.85rem; }
  .gr-langs a { color: var(--muted); text-decoration: none; }
  .gr-langs a[aria-current='true'] { color: var(--fg); font-weight: 600; }
  .gr-tabs a {
    text-decoration: none; font-size: 0.9rem; padding: 4px 12px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--muted);
  }
  .gr-tabs a[aria-current='page'] { background: var(--chip); color: var(--fg); border-color: transparent; font-weight: 600; }
  .gr-doc .card:hover { border-color: var(--line); }
  .gr-doc .card p { margin: 0; }
  .gr-doc .prose p { overflow-wrap: anywhere; }
  .gr-doc:lang(ko) { word-break: keep-all; }
  .gr-note { color: var(--muted); font-size: 0.88rem; margin-top: 12px; }
  .support .btn { overflow-wrap: anywhere; }
</style>
